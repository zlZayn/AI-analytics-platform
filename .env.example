# Application metadata database used by Prisma.
DATABASE_URL="postgresql://app_user:replace-me@localhost:5432/ai_analytics"

# Required. Generate an application-specific random value; never use a checked-in placeholder.
ENCRYPTION_KEY=""

# Optional. Leave AI_API_KEY empty for offline development and tests.
AI_API_BASE="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL="gpt-4o"

# Optional. Extra request headers as a JSON object; values support {sessionId} (per conversation)
# and {version} placeholders. Headers whose placeholders cannot be resolved are skipped.
# Example for gateways that require a client session header, e.g. OpenCode Zen Go:
#   AI_API_HEADERS={"x-opencode-session":"{sessionId}"}
# Model IDs must match the provider's documentation (gateways often use versioned IDs).
AI_API_HEADERS=""

# Optional. Starting point for structured output; the app degrades on provider rejection:
# json_schema (default) -> json_object -> none. Set it when the gateway documents its support.
AI_RESPONSE_FORMAT=""

# Optional. Bottom-left sidebar version badge; shown as "v<value>" (empty hides the badge).
NEXT_PUBLIC_APP_VERSION=""

# Required only when running scripts/seed.py. It never falls back to DATABASE_URL.
SEED_DATABASE_URL=""
